{
  "name": "goal-mate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push:schema": "prisma db push",
    "db:integrity": "npm run db:integrity:today && npm run db:integrity:journal",
    "db:push": "npm run db:push:schema && npm run db:integrity",
    "db:deploy": "npm run db:push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:integrity",
    "setup": "npm install && npm run db:generate && npm run db:push",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:integrity:today": "prisma db execute --file prisma/today-workspace-integrity.sql --schema prisma/schema.prisma",
    "db:integrity:journal": "prisma db execute --file prisma/journal-integrity.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.8.13",
    "@copilotkit/react-ui": "^1.8.13",
    "@copilotkit/runtime": "^1.8.13",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@uiw/react-markdown-preview": "^5.2.0",
    "@uiw/react-md-editor": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "next": "15.3.6",
    "openai": "^4.104.0",
    "prisma": "^6.8.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "styled-jsx": "^5.1.7",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.18"
  }
}
